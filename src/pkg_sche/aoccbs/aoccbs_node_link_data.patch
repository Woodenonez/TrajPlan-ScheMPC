diff --git a/src/aoccbs/models/core/loaders.py b/src/aoccbs/models/core/loaders.py
index f93b1f9..9cb1755 100644
--- a/src/aoccbs/models/core/loaders.py
+++ b/src/aoccbs/models/core/loaders.py
@@ -164,7 +164,10 @@ def save_model1_state_graph(state_graph, folder_path=None, id=None, precision=12
     id = id if id is not None else state_graph.id
 
     # Convert graph to a JSON-serializable format
-    graph_data = json_graph.node_link_data(state_graph.graph)
+    # TrajPlan-ScheMPC: explicit edges= pins the output key to 'edges' regardless of the
+    # installed networkx's default (older ones emit 'links'; the rest of this module always
+    # reads 'edges'), avoiding a KeyError on save.
+    graph_data = json_graph.node_link_data(state_graph.graph, edges="edges")
 
     # Round numerical values to specified precision, and convert to plain floats: a graph read back
     # from file holds numpy positions, which json cannot serialize and rounding leaves as numpy.
